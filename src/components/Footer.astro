---
import { footerNote, navItems, site } from '../content/site';
import Logo from './Logo.astro';
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo variant="light" />
      <p class="site-footer__tagline">{site.tagline}</p>
      <p class="site-footer__note">{footerNote}</p>
    </div>

    <div>
      <h2 class="site-footer__heading">Navigate</h2>
      <ul class="site-footer__list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Contact</h2>
      <ul class="site-footer__list">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li>
          <a href={site.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {new Date().getFullYear()} {site.legalName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background:
      radial-gradient(ellipse 70% 80% at 10% 0%, rgba(32, 195, 188, 0.12), transparent 50%),
      var(--color-midnight);
    color: rgba(255, 255, 255, 0.78);
    padding-block: clamp(3.5rem, 8vw, 5rem) 1.5rem;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer__tagline {
    margin-top: 1.25rem;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-white);
    max-width: 18rem;
  }

  .site-footer__note {
    margin-top: 0.85rem;
    max-width: 28rem;
    color: rgba(255, 255, 255, 0.62);
    font-size: var(--text-sm);
  }

  .site-footer__heading {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .site-footer__list {
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }

  .site-footer a {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-teal);
  }

  .site-footer__bottom {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.5);
  }

  @media (min-width: 800px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 0.7fr 0.9fr;
      gap: 3rem;
    }
  }
</style>

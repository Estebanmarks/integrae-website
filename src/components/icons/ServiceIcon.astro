---
type IconName = 'systems' | 'simulation' | 'ai' | 'rnd' | 'materials' | 'leadership';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg
  class:list={['service-icon', className]}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {
    name === 'systems' && (
      <>
        <rect x="20" y="6" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.75" />
        <rect x="6" y="34" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.75" />
        <rect x="20" y="34" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.75" />
        <rect x="34" y="34" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.75" />
        <path d="M24 14v8M10 34v-6h28v6M24 22v12" stroke="currentColor" stroke-width="1.75" />
      </>
    )
  }
  {
    name === 'simulation' && (
      <>
        <path
          d="M6 34c4-10 8-16 12-16s6 8 10 8 6-12 14-18"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="18" cy="18" r="2" fill="currentColor" />
        <circle cx="28" cy="26" r="2" fill="currentColor" />
        <circle cx="42" cy="8" r="2" fill="currentColor" />
        <path d="M6 40h36" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'ai' && (
      <>
        <rect x="12" y="12" width="24" height="24" rx="4" stroke="currentColor" stroke-width="1.75" />
        <path d="M18 24h12M24 18v12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        <circle cx="24" cy="8" r="2" fill="currentColor" />
        <circle cx="24" cy="40" r="2" fill="currentColor" />
        <circle cx="8" cy="24" r="2" fill="currentColor" />
        <circle cx="40" cy="24" r="2" fill="currentColor" />
        <path d="M24 10v2M24 36v2M10 24h2M36 24h2" stroke="currentColor" stroke-width="1.5" />
      </>
    )
  }
  {
    name === 'rnd' && (
      <>
        <path
          d="M20 28c0-4 2-7 4-10 2 3 4 6 4 10a4 4 0 1 1-8 0Z"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linejoin="round"
        />
        <path d="M22 14h4M21 10h6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        <circle cx="24" cy="36" r="2" fill="currentColor" />
        <path d="M16 20h-4M36 20h-4M14 26H9M39 26h-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </>
    )
  }
  {
    name === 'materials' && (
      <>
        <circle cx="24" cy="24" r="4" stroke="currentColor" stroke-width="1.75" />
        <ellipse cx="24" cy="24" rx="14" ry="6" stroke="currentColor" stroke-width="1.5" transform="rotate(60 24 24)" />
        <ellipse cx="24" cy="24" rx="14" ry="6" stroke="currentColor" stroke-width="1.5" transform="rotate(-60 24 24)" />
        <ellipse cx="24" cy="24" rx="14" ry="6" stroke="currentColor" stroke-width="1.5" />
      </>
    )
  }
  {
    name === 'leadership' && (
      <>
        <rect x="10" y="10" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.75" />
        <rect x="22" y="22" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.75" />
        <path d="M18 18h4v4M26 26h4v4" stroke="currentColor" stroke-width="1.5" />
      </>
    )
  }
</svg>

<style>
  .service-icon {
    width: 2rem;
    height: 2rem;
    color: var(--color-teal);
    flex-shrink: 0;
  }
</style>

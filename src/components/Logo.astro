---
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
}

const { variant = 'dark', class: className = '' } = Astro.props;
---

<a class:list={['logo', `logo--${variant}`, className]} href="/" aria-label="Integrae Engineering Ltd home">
  <img
    class="logo__image"
    src="/images/logo.png"
    alt="Integræ Engineering Ltd"
    width="220"
    height="64"
    decoding="async"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .logo:hover {
    opacity: 0.92;
  }

  .logo__image {
    display: block;
    width: auto;
    height: 2.35rem;
  }

  .logo--light .logo__image {
    /* Official mark already uses bright brand colors; keep readable on dark navy */
    filter: saturate(1.05) brightness(1.08);
  }

  @media (min-width: 700px) {
    .logo__image {
      height: 2.75rem;
    }
  }
</style>

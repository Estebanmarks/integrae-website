---
import CTASection from '../../components/CTASection.astro';
import ExperienceHighlight from '../../components/ExperienceHighlight.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';
import {
  aboutCredentials,
  aboutCta,
  aboutExperienceThemes,
  aboutFounder,
  aboutMission,
  aboutPage,
  aboutPrinciples,
} from '../../content/about';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="About Integrae Engineering Ltd and founder Esteban Darío Marks, Dr.Eng. — senior-led multidisciplinary engineering and technology advisory for complex industrial systems."
  path="/about/"
>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <p class="eyebrow">{aboutPage.eyebrow}</p>
      <h1 class="heading-xl">{aboutPage.title}</h1>
      <p class="lead" style="margin-top: 1rem;">{aboutPage.lead}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container mission-grid">
      <SectionHeader heading={aboutMission.heading} />
      <div class="prose" style="color: var(--color-muted); max-width: 42rem;">
        {aboutMission.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--founder">
    <div class="container founder-grid">
      <figure class="founder-photo">
        <div class="founder-photo__frame">
          <img
            src={aboutFounder.photo.src}
            alt={aboutFounder.photo.alt}
            width="720"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="founder-photo__caption">
          {aboutFounder.name} — {aboutFounder.role}
        </figcaption>
      </figure>

      <div>
        <p class="eyebrow">Leadership</p>
        <h2 class="heading-md">{aboutFounder.heading}</h2>
        <p class="founder-name">{aboutFounder.name}</p>
        <p class="founder-role">
          {aboutFounder.credentials} — {aboutFounder.role}
        </p>
        <p class="founder-summary">{aboutFounder.summary}</p>
        <div class="prose founder-copy">
          {aboutFounder.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <h3 class="education-title">Education</h3>
        <ul class="education-list">
          {
            aboutFounder.education.map((item) => (
              <li>
                <strong>{item.credential}</strong>
                <span>{item.detail}</span>
              </li>
            ))
          }
        </ul>

        <div class="credentials-block">
          <h3 class="education-title">{aboutCredentials.heading}</h3>
          <p class="credentials-copy">{aboutCredentials.copy}</p>
          <div class="credentials-actions">
            <Button href={aboutCredentials.cta.href}>{aboutCredentials.cta.label}</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader heading={aboutExperienceThemes.heading} />
      <p class="muted" style="margin-top: -1.5rem; margin-bottom: 1.5rem; max-width: 46rem;">
        {aboutExperienceThemes.note}
      </p>
      <div>
        {
          aboutExperienceThemes.items.map((item) => (
            <ExperienceHighlight title={item.title} description={item.description} label={item.label} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--principles">
    <div class="container">
      <SectionHeader heading={aboutPrinciples.heading} />
      <div class="principles-grid">
        {
          aboutPrinciples.items.map((item) => (
            <article class="principle">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    heading={aboutCta.heading}
    copy={aboutCta.copy}
    buttonLabel={aboutCta.button}
    href={aboutCta.href}
  />
</BaseLayout>

<style>
  .mission-grid {
    display: grid;
    gap: 1.5rem;
  }

  .section--founder {
    /* Cool grey close to the portrait backdrop, so the photo does not float on stark white */
    background:
      radial-gradient(ellipse 70% 80% at 15% 30%, rgba(32, 195, 188, 0.06), transparent 55%),
      linear-gradient(180deg, #e9eef3 0%, var(--color-light) 45%, #f7f9fb 100%);
    border-block: 1px solid var(--color-border);
  }

  .founder-grid {
    display: grid;
    gap: 2rem;
  }

  .founder-photo {
    margin: 0;
  }

  .founder-photo__frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #11283a;
    border: 1px solid rgba(17, 40, 58, 0.18);
    box-shadow:
      0 18px 40px rgba(11, 25, 41, 0.12),
      inset 0 0 0 1px rgba(32, 195, 188, 0.18);
    aspect-ratio: 4 / 5;
  }

  .founder-photo__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
  }

  .founder-photo__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, transparent 62%, rgba(11, 25, 41, 0.28) 100%),
      linear-gradient(90deg, rgba(11, 25, 41, 0.12), transparent 18%, transparent 82%, rgba(11, 25, 41, 0.12));
  }

  .founder-photo__caption {
    margin-top: 0.85rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .founder-name {
    margin-top: 1rem;
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-midnight);
  }

  .founder-role {
    margin-top: 0.35rem;
    color: var(--color-teal-dark);
    font-weight: 600;
  }

  .founder-summary {
    margin-top: 1.25rem;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .founder-copy {
    margin-top: 1rem;
    color: var(--color-muted);
  }

  .education-title {
    margin-top: 2rem;
    margin-bottom: 0.85rem;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-midnight);
  }

  .education-list {
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  .education-list li {
    display: grid;
    gap: 0.2rem;
    padding: 0.95rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-light);
  }

  .education-list strong {
    color: var(--color-midnight);
  }

  .education-list span {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .credentials-block {
    margin-top: 0.5rem;
  }

  .credentials-copy {
    max-width: 40rem;
    color: var(--color-muted);
  }

  .credentials-actions {
    margin-top: 1.15rem;
  }

  .section--principles {
    background: var(--color-light);
  }

  .principles-grid {
    display: grid;
    gap: 1rem;
  }

  .principle {
    padding: 1.35rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--color-white);
    border: 1px solid var(--color-border);
  }

  .principle h3 {
    color: var(--color-midnight);
    font-size: var(--text-lg);
  }

  .principle p {
    margin-top: 0.4rem;
    color: var(--color-muted);
  }

  @media (min-width: 800px) {
    .mission-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 2.5rem;
    }

    .founder-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
      align-items: start;
    }

    .principles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .principles-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
